# Copy to .env.local. Local demo is available only with npm run dev on loopback.
LOCAL_DEMO=true
APP_URL=http://127.0.0.1:3000
# Required in production: set a long password and a random secret of 32+ characters.
APP_PASSWORD=
SESSION_SECRET=
DATABASE_PATH=./data/sarabun.sqlite
# Google Cloud OAuth Web Application; redirect must match APP_URL exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional existing Drive folder to use as the parent for the Saraban hierarchy.
DRIVE_ROOT_FOLDER_ID=
# Optional path to Chrome/Edge; otherwise install Chromium: npx playwright install chromium
CHROMIUM_EXECUTABLE_PATH=
