# Copy to .env.local. This workspace runs on loopback for single-user access.
# Login is disabled for now. Set true to enable the password screen again.
SARABUN_REQUIRE_LOGIN=false
LOCAL_DEMO=true
APP_URL=http://127.0.0.1:3000
# APP_PASSWORD is only required when SARABUN_REQUIRE_LOGIN=true.
# Keep the existing SESSION_SECRET: it also encrypts Google Drive credentials.
APP_PASSWORD=
SESSION_SECRET=
DATABASE_PATH=./data/sarabun.sqlite
# Google Cloud OAuth Web Application; redirect must match APP_URL exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional existing Drive folder to use as the parent for the Saraban hierarchy.
DRIVE_ROOT_FOLDER_ID=
# Optional path to Chrome/Edge; otherwise install Chromium: npx playwright install chromium
CHROMIUM_EXECUTABLE_PATH=
